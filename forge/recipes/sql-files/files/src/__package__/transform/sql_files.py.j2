# Receita sql-files (transform) - gerada por `forge init --recipe sql-files`.
# Como conecta: usa o connect() da receita duckdb (forge init --recipe duckdb; pip install
#   "duckdb>=1.3"). Rode num job Prefect, num hook ou à mão dentro do envelope:
#   python -m forge env -t dev -- python -m [[ package ]].transform.sql_files
# Variáveis (env do alvo no forge.yaml): SQL_FILES_DIR (padrão sql/sql-files),
#   SQL_FILES_LAYERS (camadas em ordem, separadas por vírgula; padrão staging,marts), mais as
#   do duckdb (DUCKDB_DATABASE...).
# dev x prd: o mesmo SQL nos dois alvos; muda o banco e o lago, só pelo env do alvo.
# Regras: dentro de cada camada os arquivos rodam em ordem lexical, então todo nome leva
#   prefixo numérico (01_, 02_). Todo script é idempotente (CREATE OR REPLACE, INSERT ... ON
#   CONFLICT), porque não há rollback entre arquivos: falha no 3 deixa o 1 e o 2 aplicados.
#   Camada sem nenhum .sql reprova aqui, em vez de ser pulada em silêncio.
# Documentação: https://duckdb.org/docs/stable/sql/statements/create_table (duckdb 1.3)
from __future__ import annotations

import os
import sys
from pathlib import Path
from typing import Protocol

from [[ package ]].engine.duckdb_connection import connect


class SqlConnection(Protocol):
    def execute(self, query: str) -> object: ...


def run_layer(conn: SqlConnection, layer_dir: Path) -> list[str]:
    scripts = sorted(layer_dir.glob("*.sql"))
    if not scripts:
        raise FileNotFoundError(f"camada sem nenhum .sql: {layer_dir}")
    for script in scripts:
        conn.execute(script.read_text(encoding="utf-8"))
        print(f"{layer_dir.name}/{script.name}: aplicado")
    return [script.name for script in scripts]


def layers() -> list[Path]:
    root = Path(os.environ.get("SQL_FILES_DIR", "sql/sql-files"))
    names = os.environ.get("SQL_FILES_LAYERS", "staging,marts").split(",")
    return [root / name.strip() for name in names if name.strip()]


def run() -> int:
    with connect() as conn:
        for layer in layers():
            run_layer(conn, layer)
    return 0


if __name__ == "__main__":
    sys.exit(run())
