# Receita minio (storage) - gerada por `forge init --recipe minio`.
# Como conecta: boto3 (pip install "boto3>=1.34") na API S3 do MinIO em AWS_ENDPOINT_URL,
#   com endereçamento por caminho (path-style), que é o que o MinIO espera.
# Variáveis (env do alvo no forge.yaml): AWS_ENDPOINT_URL (ex.: http://localhost:9000),
#   MINIO_BUCKET, AWS_ACCESS_KEY_ID e AWS_SECRET_ACCESS_KEY (segredos: secret://AWS_ACCESS_KEY_ID,
#   secret://AWS_SECRET_ACCESS_KEY). A chave pode ser escopada só ao bucket: o bootstrap confere
#   o próprio bucket (head_bucket) e nunca lista a conta.
# Expiração: desligada por padrão; nenhum objeto some sem ninguém pedir. Para expirar os
#   objetos depois de N dias, declare MINIO_LIFECYCLE_DAYS: "N" no env do alvo e rode o deploy;
#   o bootstrap grava a regra landing-expiry. Sem a variável, o bucket não ganha regra. Com a
#   variável declarada, o bootstrap substitui as regras de ciclo de vida que o bucket já tem.
# dev x prd: cada alvo tem o próprio bucket (ex.: [[ name ]]-dev e [[ name ]]-prd), lido em
#   runtime do env do alvo; nunca um bucket dividido.
# Layout: <tenant>/<dataset>/data=YYYY-MM-DD/ - o tenant vem antes do dataset (um tenant nunca
#   lista o prefixo de outro) e a data é partição Hive, que todo leitor Hive entende.
# Uso: `python -m forge env -t dev -- python -m [[ package ]].storage.minio_landing bootstrap`
#   cria o bucket que falta (e a expiração, se declarada); `... health` confere o acesso. O
#   bootstrap roda no job minio-bootstrap (after_up).
# Documentação: https://boto3.amazonaws.com/v1/documentation/api/latest/reference/services/s3.html (boto3 1.34)
from __future__ import annotations

import argparse
import os
from datetime import date
from typing import Any

import boto3
from botocore.config import Config
from botocore.exceptions import ClientError

MISSING = {"404", "NoSuchBucket", "NotFound"}
FORBIDDEN = {"403", "AccessDenied", "Forbidden"}


def bucket() -> str:
    return os.environ["MINIO_BUCKET"]


def client() -> Any:
    return boto3.client(
        "s3",
        endpoint_url=os.environ["AWS_ENDPOINT_URL"],
        region_name="us-east-1",
        aws_access_key_id=os.environ["AWS_ACCESS_KEY_ID"],
        aws_secret_access_key=os.environ["AWS_SECRET_ACCESS_KEY"],
        config=Config(s3={"addressing_style": "path"}),
    )


def landing_key(tenant: str, dataset: str, logical_date: date) -> str:
    return f"{tenant}/{dataset}/data={logical_date:%Y-%m-%d}/"


def ensure_bucket(s3: Any) -> None:
    try:
        s3.head_bucket(Bucket=bucket())
    except ClientError as error:
        code = str(error.response.get("Error", {}).get("Code", ""))
        if code in MISSING:
            s3.create_bucket(Bucket=bucket())
            return
        if code in FORBIDDEN:
            raise SystemExit(
                f"bucket {bucket()}: a chave AWS_ACCESS_KEY_ID não tem permissão nele "
                f"(código {code}); confira na política do MinIO (console ou `mc admin policy`) "
                f"se a chave alcança esse bucket com leitura e escrita, e se MINIO_BUCKET "
                f"está certo no env do alvo"
            ) from error
        raise


def lifecycle_days() -> int | None:
    declared = os.environ.get("MINIO_LIFECYCLE_DAYS", "").strip()
    if not declared:
        return None
    if not declared.isdigit() or int(declared) < 1:
        raise SystemExit(
            f"MINIO_LIFECYCLE_DAYS={declared!r}: use um número inteiro de dias (1 ou mais) "
            f"no env do alvo, ou remova a variável para não expirar nada"
        )
    return int(declared)


def bootstrap() -> None:
    s3 = client()
    ensure_bucket(s3)
    days = lifecycle_days()
    if days is None:
        return
    rule = {
        "ID": "landing-expiry",
        "Status": "Enabled",
        "Filter": {"Prefix": ""},
        "Expiration": {"Days": days},
    }
    s3.put_bucket_lifecycle_configuration(
        Bucket=bucket(), LifecycleConfiguration={"Rules": [rule]}
    )


def health() -> None:
    client().head_bucket(Bucket=bucket())


def main() -> None:
    parser = argparse.ArgumentParser()
    parser.add_argument("action", choices=["bootstrap", "health"])
    {"bootstrap": bootstrap, "health": health}[parser.parse_args().action]()


if __name__ == "__main__":
    main()
