# Receita minio - job de gatilho deploy: cria o bucket do alvo que falta no MinIO já de pé e,
#   só se MINIO_LIFECYCLE_DAYS estiver no env do alvo, a regra de expiração.
# Como conecta: o forge roda a task abaixo no momento after_up de todo deploy, no executor
#   local, com o envelope do alvo; falha da task = release failed.
# Variáveis: as da receita (forge recipes -o json); nenhuma é lida aqui.
# dev x prd: igual nos dois alvos; o que muda vem do env do alvo.
# Documentação: https://github.com/minio/minio (boto3 1.34 / MinIO RELEASE.2025-09-07T16-13-09Z)
trigger:
  deploy:
    when: after_up
tasks:
  - key: bootstrap
    run: [python, -m, [[ package ]].storage.minio_landing, bootstrap]
