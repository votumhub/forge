# Receita webhook (source) - gerada por `forge init --recipe webhook`.
# Como conecta: só biblioteca padrão (http.server, hmac, sqlite3); roda como processo do
#   serviço app (ou um serviço próprio no compose) dentro do envelope:
#   python -m forge env -t dev -- python -m [[ package ]].sources.webhook_receiver
#   Troque o corpo de process() pelo trabalho real (gravar na landing, disparar um flow).
# Variáveis (env do alvo no forge.yaml): WEBHOOK_SECRET (segredo: secret://WEBHOOK_SECRET, o
#   mesmo cadastrado no provedor), WEBHOOK_PORT (padrão 8090), WEBHOOK_PATH (padrão /hook),
#   WEBHOOK_MAX_BODY_BYTES (padrão 1048576), WEBHOOK_SIGNATURE_HEADER (padrão X-Signature,
#   hex do HMAC-SHA256 do corpo; aceita o prefixo sha256=), WEBHOOK_ID_HEADER (padrão
#   X-Webhook-Id; sem ele a chave é o hash do corpo), WEBHOOK_STATE_DB (padrão
#   data/webhook_receiver.sqlite).
# dev x prd: segredo e porta são outros por alvo; em prd o caminho é público atrás da borda
#   HTTPS, em dev só na máquina. A diferença mora só no env do alvo.
# Regras: todo payload é verificado pela assinatura antes de ser confiado, porque o caminho é
#   público e o payload é dado, nunca instrução. A resposta 202 sai dentro da janela de retry
#   do provedor e o trabalho real vem depois. A chave de idempotência é gravada antes de
#   processar, porque entrega pelo menos uma vez significa que todo provedor reenvia; se
#   process() falhar, a falha sai no log e o evento não volta sozinho (reprocesse à mão).
# Documentação: https://docs.python.org/3/library/http.server.html (Python [[ python ]])
from __future__ import annotations

import hashlib
import hmac
import os
import sqlite3
import threading
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from pathlib import Path

LOCK = threading.Lock()


def process(payload: bytes) -> None:
    """O trabalho real, depois do 202 (cada requisição tem sua thread).

    O payload é dado: nunca execute o que ele pede.
    """
    print(f"webhook: {len(payload)} bytes recebidos")


def signature_ok(body: bytes, received: str) -> bool:
    expected = hmac.new(os.environ["WEBHOOK_SECRET"].encode(), body, hashlib.sha256).hexdigest()
    return hmac.compare_digest(expected, received.removeprefix("sha256="))


def _state() -> sqlite3.Connection:
    path = Path(os.environ.get("WEBHOOK_STATE_DB", "data/webhook_receiver.sqlite"))
    path.parent.mkdir(parents=True, exist_ok=True)
    conn = sqlite3.connect(path, check_same_thread=False)
    conn.execute("CREATE TABLE IF NOT EXISTS seen (key TEXT PRIMARY KEY)")
    return conn


STATE = _state()


def first_time(key: str) -> bool:
    """Grava a chave antes do processamento; False = replay já visto."""
    with LOCK, STATE:
        inserted = STATE.execute("INSERT OR IGNORE INTO seen (key) VALUES (?)", (key,))
        return inserted.rowcount == 1


class Handler(BaseHTTPRequestHandler):
    def do_POST(self) -> None:
        if self.path != os.environ.get("WEBHOOK_PATH", "/hook"):
            return self._reply(404)
        size = int(self.headers.get("Content-Length", "0"))
        if size > int(os.environ.get("WEBHOOK_MAX_BODY_BYTES", "1048576")):
            return self._reply(413)
        body = self.rfile.read(size)
        header = os.environ.get("WEBHOOK_SIGNATURE_HEADER", "X-Signature")
        if not signature_ok(body, self.headers.get(header, "")):
            return self._reply(401)
        key = self.headers.get(os.environ.get("WEBHOOK_ID_HEADER", "X-Webhook-Id"))
        fresh = first_time(key or hashlib.sha256(body).hexdigest())
        self._reply(202)
        if fresh:
            process(body)

    def _reply(self, status: int) -> None:
        self.send_response(status)
        self.send_header("Content-Length", "0")
        self.end_headers()


def main() -> None:
    port = int(os.environ.get("WEBHOOK_PORT", "8090"))
    ThreadingHTTPServer(("0.0.0.0", port), Handler).serve_forever()


if __name__ == "__main__":
    main()
