forge: 2

bundle:
  name: [[ name ]]

include:
  - resources/*.yaml

variables:
  work_pool:
    description: work pool do Prefect que executa os jobs deste bundle
    default: [[ work_pool ]]

env:
  PREFECT_API_URL: http://localhost:4200/api
  PREFECT_PORT: "4200"
  PREFECT_WORK_POOL: ${var.work_pool}
  PREFECT_EXTRA_PIP_PACKAGES: -e ${bundle.root}

targets:
  dev:
    mode: development
    default: true
    secrets:
      provider: dotenv
      path: .forge/secrets/dev.env
  prd:
    mode: production
    git:
      tag: "v*"
    secrets:
      provider: env
