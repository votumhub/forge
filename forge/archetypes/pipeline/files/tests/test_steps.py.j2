from datetime import date

import pytest

from [[ package ]].steps import summarize, window


def test_window_covers_the_last_days() -> None:
    assert window(date(2026, 1, 10), 3) == (date(2026, 1, 7), date(2026, 1, 10))


def test_window_refuses_zero_days() -> None:
    with pytest.raises(ValueError):
        window(date(2026, 1, 10), 0)


def test_summarize_counts_rows() -> None:
    assert summarize([{"a": 1}, {"a": 2}]) == {"rows": 2}
