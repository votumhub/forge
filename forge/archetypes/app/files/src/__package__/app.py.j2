"""Serviço HTTP mínimo: /health para o forge, / para o resto. Configuração só por env."""

from __future__ import annotations

import json
import os
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer


def answer(path: str) -> tuple[int, dict[str, str]]:
    if path == "/health":
        return 200, {"status": "ok"}
    if path == "/":
        return 200, {"service": "[[ name ]]", "target": os.environ.get("FORGE_TARGET", "local")}
    return 404, {"error": "not found", "path": path}


class Handler(BaseHTTPRequestHandler):
    def do_GET(self) -> None:
        status, body = answer(self.path)
        payload = json.dumps(body).encode()
        self.send_response(status)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(payload)))
        self.end_headers()
        self.wfile.write(payload)


def main() -> None:
    ThreadingHTTPServer(("0.0.0.0", 8000), Handler).serve_forever()


if __name__ == "__main__":
    main()
